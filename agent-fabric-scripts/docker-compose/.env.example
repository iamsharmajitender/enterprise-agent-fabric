# Copy to agent-fabric-scripts/docker-compose/.env for local overrides. Compose reads these if present.

POSTGRES_USER=fabric
POSTGRES_PASSWORD=fabric

# JDBC / SQLAlchemy URLs from inside the Compose network
AFD_DATABASE_URL=jdbc:postgresql://postgres:5432/afd
ADP_DATABASE_URL=jdbc:postgresql://postgres:5432/adp
AR_SHARED_DATABASE_URL=postgresql+psycopg://fabric:fabric@postgres:5432/ar_shared
AR_CUSTOM_DATABASE_URL=postgresql+psycopg://fabric:fabric@postgres:5432/ar_custom
ACR_DATABASE_URL=jdbc:postgresql://postgres:5432/acr

# Control Plane UI (catalogue browser; no Fabric service APIs)
ACP_PORT=3006
ADP_BASE_URL=http://localhost:3007
ACR_BASE_URL=http://localhost:3009
DATA_PLANE_URL=http://localhost:3007
REGISTRY_URL=http://localhost:3009
RUNTIME_URL=http://localhost:3008
RUNTIME_URLS=http://localhost:3008,http://localhost:3015
AFD_PORT=3005
ADP_PORT=3007
AR_PORT=3008
AR_CUSTOM_PORT=3015
ACR_PORT=3009
AGENT_FABRIC_MOCKS_PORT=3010
AADP_PORT=3012
AACP_PORT=3013
AUDIT_DATA_PLANE_URL=http://localhost:3012
AUDIT_DATABASE_URL=jdbc:postgresql://postgres:5432/audit

# Corpus search gateways (each row in dataplane.corpora.url is independent).
# Browse configured rows at http://localhost:3006/corpora after Compose is up.
# Docker network hostnames below; from the host replace agent-mocks with localhost.
CORPUS_GATEWAY_ASSISTANT=http://agent-mocks:3010/v1/search/assistant
CORPUS_GATEWAY_LEGAL=http://agent-mocks:3010/v1/search/legal
CORPUS_GATEWAY_KYC=http://agent-mocks:3010/v1/search/kyc
# Dedicated per corpus: http://agent-mocks:3010/corpora/{corpus_id}/search

# Postgres GUI (System PostgreSQL, server postgres, user/password fabric)
ADMINER_PORT=8080

# Runtime LLM (FABRIC_LLM_STUB=0, default in Compose). Pick one backend:
#
# Gemini (recommended if you have a Google AI key):
#   FABRIC_LLM_MODEL=google_genai:gemini-3.5-flash-lite
#   GOOGLE_API_KEY=your-key-from-https://aistudio.google.com/apikey
#
# Local Ollama:
#   FABRIC_LLM_MODEL=ollama:qwen3:14b
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
FABRIC_LLM_MODEL=google_genai:gemini-3.5-flash-lite
GOOGLE_API_KEY=
# 0 = ProviderLlm (cloud/local model). 1 = SeedStubLlm (deterministic demos without a model).
FABRIC_LLM_STUB=0
# Transient LLM failures (timeout, connection): exponential backoff retries.
FABRIC_LLM_RETRY_MAX=3
FABRIC_LLM_RETRY_BASE_S=1
FABRIC_LLM_RETRY_MAX_BACKOFF_S=30
# 1 = raw JSON on run.stage.* / run.llm.* in Loki (recommended locally). 0 = digests only.
FABRIC_LOG_STAGE_PAYLOADS=1
