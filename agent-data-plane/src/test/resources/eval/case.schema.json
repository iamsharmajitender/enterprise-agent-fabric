{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.local/eval/case.schema.json",
  "title": "Fabric eval case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "ingress", "channel", "claims", "expected"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "ingress": { "type": "string", "enum": ["chat", "jobs"] },
    "channel": { "type": "string", "minLength": 1 },
    "message": { "type": ["string", "null"] },
    "route_id": { "type": ["string", "null"] },
    "claims": { "type": "object" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": { "type": "string", "enum": ["route", "clarify", "abstain"] },
        "route_id": { "type": "string" },
        "route_version": { "type": "string" }
      }
    }
  }
}
